# ECOsoporte — copie a `.env`. Funciona sin cambios tanto para desarrollo local (`npm run dev`) como
# para una demo con Docker en http://localhost:8080. Lo comentado usa valores por defecto.
# Para producción complete todo lo marcado [OBLIGATORIO].

# ---------- General ----------
# [OBLIGATORIO en producción] Dirección exacta con la que se abre el sistema (se usa en mails,
# redirecciones y control de origen: si no coincide, se rechazan los cambios).
# Por defecto: http://localhost:5173 en desarrollo y http://localhost:APP_PORT en Docker.
# APP_URL=https://soporte.ecologia.misiones.gob.ar
# Puerto publicado por el proxy en Docker
APP_PORT=8080
LOG_LEVEL=info
# Cookies "Secure": por defecto activas en Docker. Chrome y Firefox las aceptan en http://localhost,
# pero NO al entrar por IP o nombre de red con HTTP plano (p. ej. http://192.168.0.10:8080): en ese
# caso, o en Safari por HTTP, ponga COOKIE_SECURE=false y APP_URL con esa dirección. Con HTTPS, true.
# COOKIE_SECURE=true
# Docker: HSTS, solo si se sirve por HTTPS (p. ej. detrás de un proxy con certificado)
# HSTS=max-age=31536000
# Docker: IP o red (CIDR) del proxy que esté delante de Caddy, para registrar la IP real del cliente
# CADDY_TRUSTED_PROXIES=10.0.0.5/32

# ---------- Base de datos ----------
# Docker: contraseña del Postgres del compose [OBLIGATORIO cambiar antes del primer arranque].
# Se usa dentro de una URL: solo letras, números, guion y guion bajo (p. ej. `openssl rand -hex 24`).
POSTGRES_PASSWORD=cambiar-esta-clave
# Local: si se define DATABASE_URL se usa ese Postgres en lugar del embebido.
# DATABASE_URL=postgres://usuario:clave@host:5432/ecosoporte
# Puerto del Postgres embebido (local)
# PG_PORT=5433
# Carpeta de datos local
# DATA_DIR=.data
# Docker: clave del usuario de solo lectura `metabase_ro` (perfil stats). Vacía = no se crea.
METABASE_DB_PASSWORD=cambiar-clave-metabase
# Docker: puerto de Metabase, solo en 127.0.0.1 del servidor
# METABASE_PORT=3030
# METABASE_IMAGE=metabase/metabase:latest

# ---------- Secretos [OBLIGATORIO: cadenas aleatorias de 32+ caracteres] ----------
SESSION_SECRET=cambiar-por-una-cadena-aleatoria-de-32-o-mas-caracteres-1
ALTCHA_HMAC_KEY=cambiar-por-una-cadena-aleatoria-de-32-o-mas-caracteres-2

# ---------- Ingreso Único (portal) ----------
PORTAL_URL=https://portal.ecologia.misiones.gob.ar
# A dónde ir al cerrar sesión (por defecto PORTAL_URL)
# PORTAL_LOGOUT_URL=
# HS256 (secreto compartido) o RS256 (clave pública o JWKS)
PORTAL_JWT_ALG=HS256
PORTAL_JWT_SECRET=cambiar-por-el-secreto-compartido-con-el-portal-32
# PORTAL_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# PORTAL_JWT_JWKS_URL=
PORTAL_JWT_ISSUER=portal.ecologia.misiones.gob.ar
# PORTAL_JWT_AUDIENCE=ecosoporte
# Clave servidor a servidor para GET /api/sso/usuario-existe (header X-Portal-Key)
PORTAL_API_KEY=cambiar-por-una-clave-larga-compartida-con-el-portal

# ---------- Sistema de Personal (solo lectura) ----------
# Vacío = proveedor simulado con los empleados del seed
# PERSONAL_DATABASE_URL=postgres://solo_lectura:clave@host:5432/personal

# ---------- Correo ----------
# Vacío en local: los mails se guardan en .data/mails y se ven en /dev/mails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="ECOsoporte <no-responder@ecologia.misiones.gob.ar>"

# ---------- Datos iniciales ----------
# true carga datos de demostración (usuarios de prueba con contraseña conocida).
# En una instalación real poner false y definir el administrador inicial.
SEED_DEMO=true
# ADMIN_EMAIL=admin@ecologia.misiones.gob.ar
# ADMIN_PASSWORD=

# ---------- Ajustes ----------
# Intentos de login por minuto (por IP y por email)
# LOGIN_MAX_INTENTOS=10
